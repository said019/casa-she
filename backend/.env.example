# === Requeridas ===
DATABASE_URL=postgresql://usuario@localhost:5432/casa_she
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# Desactiva los cron jobs en desarrollo si no los necesitas
ENABLE_CRON_JOBS=false

# === Opcionales (cada feature se desactiva si falta su credencial) ===
# Pagos con tarjeta — MercadoPago (Checkout Pro).
# Sin MP_ACCESS_TOKEN la opción "Tarjeta" se oculta en el checkout (degrada limpio).
MP_ACCESS_TOKEN=            # Access Token de producción (APP_USR-...). Panel MP → Tus integraciones.
MP_WEBHOOK_SECRET=          # Firma secreta del webhook (Panel MP → Webhooks). Vacío = verificación omitida (inseguro).
BACKEND_URL=               # URL pública del backend; arma notification_url (ej. https://backend-xxxx.up.railway.app)

# Pagos con tarjeta (Stripe) — LEGACY, reemplazado por MercadoPago. Se deja por compatibilidad.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STATEMENT_DESCRIPTOR=CASA SHE

# Correos transaccionales (Resend)
RESEND_API_KEY=
EMAIL_FROM=Casa She <onboarding@resend.dev>

# Subida de comprobantes / media (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Drive (OAuth; compartir la carpeta/archivos como lector público)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Check-in QR (firma de tokens) — producción debe definir un valor único y secreto
CHECKIN_SECRET=

# v1: deja en true para desactivar el envío automático de WhatsApp (usamos wa.me + email)
DISABLE_WHATSAPP=true
